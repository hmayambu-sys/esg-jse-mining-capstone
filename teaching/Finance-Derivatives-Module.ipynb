# 1. Futures Example - Hedging Copper Price
# Anglo American produces copper. Future price = Spot + Cost of carry.
spot = 9500
rate = 0.08
time = 1
futures = spot * (1 + rate*time)
print(f'Copper Spot: ${spot}, 1Y Futures: ${futures}')
print('Anglo can lock this price to protect revenue')

# 2. Options Example - Anglo American Platinum (Amplats)
# Put Option = Insurance. Anglo pays premium to protect if platinum price falls.
spot_plat = 1000 # $/oz Platinum
strike = 950 # Put strike - minimum price Anglo wants
premium = 45 # Cost of insurance $45/oz
production = 100000 # oz
def put_payoff(spot_at_expiry, strike, premium):
    payoff = max(strike - spot_at_expiry, 0) - premium
    return payoff
scenarios = [800, 950, 1100, 1300]
print('Anglo Platinum Put Hedge - Strike 45')
for price in scenarios:
    profit = put_payoff(price, strike, premium) * production
    total_rev = (price * production) + (profit)
    print(f'If Platinum = ${price}: Hedge P/L = ${profit:,.0f} | Effective revenue protected')
print('\nTeaching point: ESG risk = price volatility. Put option is ESG financial hedge.')

# 3. Swaps Example - Gold Fields Hedging
gold_spot = 1800 # $/oz
fixed_swap_rate = 1850 # $/oz
gold_price_scenarios = [1600, 1800, 2000]
print('Gold Fields Swap Hedge')
for price in gold_price_scenarios:
    swap_payoff = fixed_swap_rate - price
    revenue = price + swap_payoff # Effective fixed revenue
    print(f'Gold Price: ${price} | Swap Payoff: ${swap_payoff} | Effective Revenue: ${revenue}')
print('\nTeaching point: Swaps lock in revenue stability vs market volatility.')

# 4. JSE Mining ESG Risk Case - Sibanye Gold
sib_gold_spot = 1750
esg_risk_premium = 50 # Extra volatility due to ESG risks
strike = 1700
premium = 30
def put_payoff(spot, strike, premium):
    return max(strike - spot, 0) - premium
print('Sibanye Gold ESG Risk Hedge')
esg_shock_price = sib_gold_spot - esg_risk_premium
payoff = put_payoff(esg_shock_price, strike, premium)
print(f'ESG Shock: Gold drops to ${esg_shock_price}. Put payoff: ${payoff}')
print('\nTeaching point: Options hedge ESG downside risk, preserve upside.')

# 5. ESG-Linked Derivatives - New Frontier
esg_score = 0.7 # 0-1 scale
base_swap_rate = 1850
esg_discount = 20 * esg_score # Better ESG = lower rate
effective_swap_rate = base_swap_rate - esg_discount
print(f'Gold Fields ESG Score: {esg_score}. Effective swap rate: ${effective_swap_rate}')
print('\nTeaching point: ESG-linked derivatives incentivize sustainability.')

